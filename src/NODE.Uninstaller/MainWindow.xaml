<Window x:Class="NODE.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NODE Uninstaller" Width="1440" Height="880" MinWidth="1100" MinHeight="690"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource AppBackground}"
        SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="MicroLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="StatisticValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="29" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#273850" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="ScrollItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="5,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="RowBase" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                    Padding="10,8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBase" Property="Background" Value="#1A3049" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBase" Property="Background" Value="#173750" />
                <Setter TargetName="RowBase" Property="BorderBrush" Value="#286B92" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#192A40" />
      <Setter Property="Foreground" Value="#3A6683" />
      <Setter Property="Width" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="#101A2B">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#365570" CornerRadius="5" Margin="2" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#243954" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="242" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Persistent navigation -->
      <Border Grid.Column="0" Background="#0C1524" BorderBrush="#23334A" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
            <RowDefinition Height="136" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="17,13,13,9" MouseLeftButtonDown="DragTitleBar">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="65" Height="61" CornerRadius="12" Background="#131F31" BorderBrush="#365C80" BorderThickness="1" ClipToBounds="True">
              <Image Source="Assets/NODE-Uninstaller-UI.png" Stretch="Uniform" Margin="1" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
              <TextBlock Text="NODE" FontWeight="ExtraBold" FontSize="19" Foreground="White" />
              <TextBlock Text="UNINSTALLER" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="11" />
              <TextBlock Text="BY NODE DEVELOPMENT" Foreground="#617C9A" FontSize="8" Margin="0,5,0,0" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,16,10,0">
            <StackPanel>
              <TextBlock Text="APPLICATIONS" Style="{StaticResource MicroLabel}" Margin="13,0,0,9" />
              <Button x:Name="NavAll" Tag="Active" Content="▦  All Applications" Style="{StaticResource NavButton}" Click="NavAll_Click" />
              <Button x:Name="NavDesktop" Content="▣  Desktop Apps" Style="{StaticResource NavButton}" Click="NavDesktop_Click" />
              <Button x:Name="NavStore" Content="▢  Microsoft Store" Style="{StaticResource NavButton}" Click="NavStore_Click" />
              <TextBlock Text="ADVANCED TOOLS" Style="{StaticResource MicroLabel}" Margin="13,28,0,9" />
              <Button x:Name="NavForced" Content="⌁  Forced Uninstall" Style="{StaticResource NavButton}" Click="NavFeature_Click" Tag="Forced Uninstall" />
              <Button x:Name="NavBatch" Content="▥  Batch Uninstaller" Style="{StaticResource NavButton}" Click="NavFeature_Click" Tag="Batch Uninstaller" />
              <Button x:Name="NavScanner" Content="◈  Leftover Scanner" Style="{StaticResource NavButton}" Click="NavFeature_Click" Tag="Leftover Scanner" />
              <Button x:Name="NavHunter" Content="◎  Hunter Mode" Style="{StaticResource NavButton}" Click="NavFeature_Click" Tag="Hunter Mode" />
              <TextBlock Text="SECURITY &amp; SYSTEM" Style="{StaticResource MicroLabel}" Margin="13,28,0,9" />
              <Button x:Name="NavBackup" Content="⬡  Backups &amp; Recovery" Style="{StaticResource NavButton}" Click="NavFeature_Click" Tag="Backups &amp; Recovery" />
              <Button x:Name="NavHistory" Content="◷  Activity History" Style="{StaticResource NavButton}" Click="NavFeature_Click" Tag="Activity History" />
              <Button x:Name="NavSettings" Content="⚙  Settings" Style="{StaticResource NavButton}" Click="NavFeature_Click" Tag="Settings" />
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="#23334A" BorderThickness="0,1,0,0" Padding="17,17">
            <StackPanel>
              <Border Background="#142638" BorderBrush="#27516A" BorderThickness="1" CornerRadius="8" Padding="10,8">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="#3DE0B2" Margin="0,0,8,0" />
                  <TextBlock Text="STANDARD UNINSTALL ENABLED" Foreground="#A7F1D5" FontWeight="SemiBold" FontSize="10" />
                </StackPanel>
              </Border>
              <TextBlock Text="v0.1.1  •  PORTABLE BUILD" Foreground="#728BA9" FontSize="10" Margin="1,14,0,0" />
              <TextBlock Text="Clean Removal. Complete Control." Foreground="#5B7695" FontSize="10" Margin="1,5,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Main content -->
      <Grid Grid.Column="1" Margin="27,0,27,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="62" />
          <RowDefinition Height="82" />
          <RowDefinition Height="128" />
          <RowDefinition Height="*" />
          <RowDefinition Height="39" />
        </Grid.RowDefinitions>

        <!-- Draggable titlebar and window controls -->
        <Grid Grid.Row="0" MouseLeftButtonDown="DragTitleBar" Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="NODE / " Foreground="#6588A6" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="APPLICATION MANAGER" Foreground="#DDEBFF" FontSize="12" FontWeight="SemiBold" />
            <Border Background="#11283B" BorderBrush="#236C8D" BorderThickness="1" CornerRadius="8" Margin="17,0,0,0" Padding="10,4">
              <TextBlock Text="PORTABLE RELEASE  ·  0.1.1" Foreground="{StaticResource AccentCyan}" FontSize="10" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="IgnoreTitleDrag">
            <Button Content="─" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" />
            <Button x:Name="MaximizeButton" Content="□" FontSize="17" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize / restore" />
            <Button Content="✕" Foreground="#FF7689" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close" />
          </StackPanel>
        </Grid>

        <!-- Hero -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageHeading" Text="Installed applications" Foreground="{StaticResource TextStrong}" FontWeight="Bold" FontSize="30" />
            <TextBlock x:Name="PageDescription" Text="Run official uninstallers, or explore installed software on this PC." Foreground="{StaticResource TextMuted}" FontSize="13" Margin="1,8,0,0" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="RefreshButton" Content="↻  Refresh inventory" Style="{StaticResource OutlineActionButton}" VerticalAlignment="Center" Click="Refresh_Click" />
        </Grid>

        <!-- Stats cards -->
        <Grid Grid.Row="2" Margin="0,0,0,17">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="13"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="13"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="19,14">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="TOTAL DISCOVERED" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="TotalCountText" Text="—" Style="{StaticResource StatisticValue}" Margin="0,6,0,0" />
                <TextBlock Text="Visible installation records" Foreground="#7793B5" FontSize="11" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Right" Text="▦" Foreground="#2EADE2" FontSize="31" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="19,14">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="DESKTOP APPLICATIONS" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="DesktopCountText" Text="—" Style="{StaticResource StatisticValue}" Margin="0,6,0,0" />
                <TextBlock Text="Registered Win32 programs" Foreground="#7793B5" FontSize="11" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Right" Text="▣" Foreground="#FF647D" FontSize="31" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="19,14">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="MICROSOFT STORE" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="StoreCountText" Text="—" Style="{StaticResource StatisticValue}" Margin="0,6,0,0" />
                <TextBlock Text="Current user's main packages" Foreground="#7793B5" FontSize="11" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Right" Text="▢" Foreground="#8E8AFF" FontSize="31" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="3">
          <!-- Inventory panel -->
          <Grid x:Name="InventoryPanel">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="322"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="17,14,17,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchHint" Text="⌕  Search installed applications or publishers..." Foreground="#6684A2" IsHitTestVisible="False" FontSize="12" Margin="13,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                  <Border Grid.Column="1" VerticalAlignment="Center" Background="#1A2A3F" CornerRadius="7" Margin="12,0,0,0" Padding="10,8">
                    <TextBlock x:Name="ShowingCount" Text="0 shown" Foreground="{StaticResource TextMuted}" FontSize="11" />
                  </Border>
                </Grid>
                <Border Grid.Row="1" Background="#152339" Margin="11,0" CornerRadius="5" Padding="14,9">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                    <TextBlock Text="APPLICATION / PUBLISHER" Style="{StaticResource MicroLabel}" />
                    <TextBlock Grid.Column="1" Text="VERSION" Style="{StaticResource MicroLabel}" />
                    <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource MicroLabel}" />
                  </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="6,5,6,7">
                  <ListBox x:Name="AppList" SelectionChanged="AppList_SelectionChanged" ItemContainerStyle="{StaticResource ScrollItem}"
                           Background="{StaticResource PanelBackground}" Foreground="{StaticResource TextStrong}"
                           BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
                           VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="48">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                          <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#22364E" BorderBrush="#2B5473" BorderThickness="1" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left">
                              <Grid>
                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="18" Foreground="#59D8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding IconSource}" Width="31" Height="31" Stretch="Uniform" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="1,0,8,0">
                              <TextBlock Text="{Binding DisplayName}" Foreground="#F1F7FF" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding PublisherLabel}" Foreground="#8099B7" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding VersionLabel}" Foreground="#B0C4DD" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0" />
                          <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" Foreground="{StaticResource AccentCyan}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="⌕" FontSize="36" Foreground="#2F7EAA" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyMessage" Text="No matching applications found" FontSize="14" Foreground="#A9BED7" Margin="0,8,0,0" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <!-- Selection details -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="17">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                  <TextBlock Text="APPLICATION DETAILS" Style="{StaticResource MicroLabel}" Margin="1,0,0,13" />
                  <Border Height="1" Background="#2B3E54" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                  <Grid>
                    <StackPanel x:Name="NoSelection" VerticalAlignment="Center" Margin="7,100,7,0">
                      <TextBlock Text="▦" FontSize="43" Foreground="#396482" HorizontalAlignment="Center" />
                      <TextBlock Text="Select an application" Foreground="#D1E1F2" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,15,0,0" />
                      <TextBlock Text="Choose a program from the list to inspect its reported installation details." Foreground="#8CA4BF" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="4,10,4,0" />
                    </StackPanel>
                    <StackPanel x:Name="SelectedDetails" Visibility="Collapsed">
                      <Grid Height="84">
                        <Border Height="76" Width="76" CornerRadius="15" Background="#1C324A" BorderBrush="#315E79" BorderThickness="1" HorizontalAlignment="Left">
                          <Grid>
                            <TextBlock Text="{Binding Initial}" Foreground="#54D7FF" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding IconSource}" Width="55" Height="55" Stretch="Uniform" />
                          </Grid>
                        </Border>
                        <Border Background="#103C41" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Padding="11,5" Margin="0,4,0,0">
                          <TextBlock Text="STANDARD UNINSTALL" Foreground="#4BF5C3" FontSize="9" FontWeight="Bold" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Foreground="White" FontWeight="Bold" FontSize="19" Margin="0,14,0,0" />
                      <TextBlock Text="{Binding PublisherLabel}" TextWrapping="Wrap" Foreground="#86ABC6" FontSize="12" Margin="0,5,0,21" />
                      <Border Background="#1B2B40" CornerRadius="10" Padding="13,14">
                        <StackPanel>
                          <TextBlock Text="VERSION" Style="{StaticResource MicroLabel}" />
                          <TextBlock Text="{Binding VersionLabel}" Foreground="#DBEAFA" Margin="0,4,0,15" TextWrapping="Wrap" />
                          <TextBlock Text="APPLICATION TYPE" Style="{StaticResource MicroLabel}" />
                          <TextBlock Text="{Binding SourceLabel}" Foreground="#DBEAFA" Margin="0,4,0,15" />
                          <TextBlock Text="REPORTED SIZE" Style="{StaticResource MicroLabel}" />
                          <TextBlock Text="{Binding SizeLabel}" Foreground="#DBEAFA" Margin="0,4,0,15" />
                          <TextBlock Text="INSTALL DATE" Style="{StaticResource MicroLabel}" />
                          <TextBlock Text="{Binding InstalledAtLabel}" Foreground="#DBEAFA" Margin="0,4,0,15" />
                          <TextBlock Text="INSTALL LOCATION" Style="{StaticResource MicroLabel}" />
                          <TextBlock Text="{Binding LocationLabel}" Foreground="#DBEAFA" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                  <TextBlock x:Name="UninstallAvailabilityText" Text="Select an application to view available actions" Foreground="#8DA6BF" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <Button x:Name="UninstallButton" Content="Uninstall selected application" Style="{StaticResource SolidActionButton}" IsEnabled="False" Click="Uninstall_Click" />
                  <Button x:Name="OpenFolderButton" Content="Open installation folder" Style="{StaticResource OutlineActionButton}" Margin="0,9,0,0" Click="OpenFolder_Click" IsEnabled="False" />
                  <Button x:Name="CopyDetailsButton" Content="Copy application details" Style="{StaticResource OutlineActionButton}" Margin="0,9,0,0" Click="CopyDetails_Click" IsEnabled="False" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- Explicit placeholders for future modules, not simulated functionality -->
          <Border x:Name="UpcomingModulePanel" Style="{StaticResource CardBorder}" Visibility="Collapsed" Padding="36">
            <Grid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <Border Width="96" Height="96" CornerRadius="22" Background="#192E43" BorderBrush="#2E6B8C" BorderThickness="1" HorizontalAlignment="Center">
                  <TextBlock Text="◆" FontSize="43" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="UpcomingModuleTitle" Text="Coming in a future update" FontWeight="Bold" FontSize="29" Foreground="#F1F7FF" TextAlignment="Center" Margin="0,27,0,0" />
                <TextBlock x:Name="UpcomingModuleBody" Text="This module is planned." Foreground="#9EB9D0" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,15,0,0" />
                <Border Background="#102F36" BorderBrush="#27665D" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,33,0,0">
                  <TextBlock Text="v0.1.1 runs registered uninstallers only after confirmation. Advanced cleanup tools remain inactive; no leftovers are deleted automatically." Foreground="#A9E7D0" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Fill="#5EE2B0" Width="7" Height="7" Margin="1,0,9,0" />
            <TextBlock x:Name="StatusText" Text="Ready to scan installed software" Foreground="{StaticResource TextMuted}" FontSize="11" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="LOCAL FIRST  ·  NO ACCOUNT  ·  NO SUBSCRIPTION" Foreground="#57718F" FontSize="10" VerticalAlignment="Center" />
        </Grid>
      </Grid>

      <!-- Explicit confirmation before any external uninstall process is started. -->
      <Grid x:Name="UninstallConfirmOverlay" Grid.ColumnSpan="2" Background="#E4050A13"
            Visibility="Collapsed" Panel.ZIndex="100">
        <Border Width="560" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#121F32" BorderBrush="#FF6B81" BorderThickness="1"
                CornerRadius="16" Padding="27">
          <StackPanel>
            <TextBlock Text="NODE UNINSTALLER / CONFIRM REMOVAL" Foreground="#FF8A9A" FontSize="11" FontWeight="Bold" />
            <TextBlock x:Name="UninstallConfirmApp" Text="Selected application" Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,14,0,5" TextWrapping="Wrap" />
            <TextBlock x:Name="UninstallConfirmPublisher" Foreground="#A8C4DF" FontSize="12" TextWrapping="Wrap" />
            <Border Background="#1B2B41" BorderBrush="#31445B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,17,0,0">
              <StackPanel>
                <TextBlock Text="REGISTERED REMOVAL COMMAND" Foreground="#71CCFF" FontWeight="Bold" FontSize="10" />
                <TextBlock x:Name="UninstallConfirmCommand" Foreground="#D2E5F8" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="95" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="UninstallConfirmWarning" Foreground="#FFD099" FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap" />
            <TextBlock Text="The manufacturer's own uninstaller will run. NODE will not delete leftovers or create a restore point in this version. Cancel if you are unsure." Foreground="#B2C9DE" FontSize="12" Margin="0,14,0,21" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Cancel" Style="{StaticResource OutlineActionButton}" Click="UninstallCancel_Click" Margin="0,0,12,0" />
              <Button x:Name="ConfirmUninstallButton" Content="Run original uninstaller" Style="{StaticResource SolidActionButton}" Click="UninstallConfirm_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Don't imply an external vendor uninstaller can safely be cancelled. -->
      <Grid x:Name="UninstallProgressOverlay" Grid.ColumnSpan="2" Background="#E4050A13"
            Visibility="Collapsed" Panel.ZIndex="101">
        <Border Width="490" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#121F32" BorderBrush="#2D779B" BorderThickness="1"
                CornerRadius="15" Padding="27">
          <StackPanel>
            <TextBlock Text="NODE UNINSTALLER / EXTERNAL PROCESS" Foreground="#70CFFF" FontSize="11" FontWeight="Bold" />
            <TextBlock x:Name="UninstallProgressTitle" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,15,0,0" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Height="7" Margin="0,22,0,18" Foreground="#36C9FC" Background="#233850" />
            <TextBlock Text="Complete the publisher's uninstall wizard if one is open. NODE is waiting for that process to exit." Foreground="#AFC5DF" FontSize="12" TextWrapping="Wrap" />
            <Button Content="Stop monitoring (do not cancel uninstall)" Style="{StaticResource OutlineActionButton}" Margin="0,20,0,0" Click="StopMonitoring_Click" />
            <TextBlock Text="This does not terminate the vendor's uninstaller; it may continue in the background." Foreground="#F6C988" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- In-app dark notification dialog: avoid bright system MessageBox windows. -->
      <Grid x:Name="NoticeOverlay" Grid.ColumnSpan="2" Background="#DB050A13"
            Visibility="Collapsed" Panel.ZIndex="102">
        <Border Width="485" MaxWidth="485" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#121F32" BorderBrush="#FF4E68" BorderThickness="1"
                CornerRadius="15" Padding="26" Effect="{x:Null}">
          <StackPanel>
            <TextBlock Text="NODE UNINSTALLER  /  NOTICE" Foreground="#FF778C" FontSize="11" FontWeight="Bold" />
            <TextBlock x:Name="NoticeTitle" Text="Notice" Foreground="#F3F8FF"
                       FontWeight="Bold" FontSize="22" Margin="0,13,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="NoticeMessage" Foreground="#AFC5DF" FontSize="13"
                       Margin="0,12,0,23" TextWrapping="Wrap" MaxHeight="260" />
            <Button x:Name="NoticeOkButton" Content="OK  ·  Close" HorizontalAlignment="Right"
                    Style="{StaticResource SolidActionButton}" Click="DismissNotice_Click" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
